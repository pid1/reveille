<?xml version="1.0"?>
<Container version="2">
  <Name>reveille-listener</Name>
  <Repository>ghcr.io/pid1/reveille-listener:latest</Repository>
  <Registry>https://github.com/pid1/reveille/pkgs/container/reveille-listener</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/pid1/reveille</Support>
  <Project>https://github.com/pid1/reveille</Project>
  <Overview>NWWS-OI listener: pushes NWS warnings for the house within seconds. Holds the account's only connection; never run a second copy anywhere. See listener/README.md.</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--env-file /mnt/user/appdata/reveille-listener/.env --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true --restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="State" Target="/data" Default="" Mode="rw" Description="Which events were already pushed, so a restart does not push them again" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/reveille-listener/data</Config>
  <Config Name="TZ" Target="TZ" Default="America/Chicago" Mode="" Description="Times in pushes" Type="Variable" Display="always" Required="false" Mask="false">America/Chicago</Config>
</Container>
